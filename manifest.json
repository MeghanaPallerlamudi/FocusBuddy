
{
  "manifest_version": 3,
  "name": "FocusBuddy - Book Boyfriend Edition",
  "version": "2.0.0",
  "description": "A bookish reminder to get back to studying.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/reading-gentleman.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusBuddy"
  }
}
